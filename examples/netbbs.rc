#!/bin/sh
#
# rc.d script for running a NetBBS node under NetBSD (design doc §2.1
# Tier 1, issue #82).
#
# PROVIDE: netbbs
# REQUIRE: NETWORKING SERVERS
# KEYWORD: shutdown
#
# rc.conf(5) variables (all optional -- the defaults below match the
# install layout in docs/NetBBS-operator-guide.md §1b/§2):
#
#	netbbs=YES					# enable the service
#	netbbs_user="netbbs"				# unprivileged user to run as
#						# (needs a real shell -- this script
#						# starts the node through su(1), so
#						# /sbin/nologin will not work)
#	netbbs_statedir="/var/lib/netbbs"		# node state; must be writable by netbbs_user
#	netbbs_config="/etc/netbbs/netbbs.toml"
#	netbbs_python="/var/lib/netbbs/.venv/bin/python"
#	netbbs_logfile="/var/lib/netbbs/netbbs.service.log"
#	netbbs_stop_timeout="150"			# seconds to wait for a graceful stop
#	netbbs_start_timeout="60"			# seconds to wait for the node to report readiness
#
# Install: copy this file from the official GitHub release/source tree to
# /etc/rc.d/netbbs, add netbbs=YES to /etc/rc.conf, then run
# `service netbbs start`. NetBBS itself is not distributed via pkgsrc.
#
# Tested: this script's shape (load order, self-backgrounding, pidfile,
# graceful stop, status) is the one running the project's own ReLink node
# on NetBSD 11.0. The defaults below are the operator guide's layout
# rather than that node's paths, so verify yours with `service netbbs
# status` after the first start.

. /etc/rc.subr

name="netbbs"
rcvar=${name}

# rc.subr(8): load_rc_config must come BEFORE the `: ${var:=default}`
# block, or every rc.conf override above is read too late to have any
# effect and the built-in defaults always win. (Issue #312: this script
# previously called it last, silently ignoring all of them --
# netbbs_ld_library_path included, which operator guide §1b tells NetBSD
# operators to set.)
load_rc_config $name

: ${netbbs_user:="netbbs"}
: ${netbbs_statedir:="/var/lib/netbbs"}
: ${netbbs_config:="/etc/netbbs/netbbs.toml"}
: ${netbbs_python:="${netbbs_statedir}/.venv/bin/python"}
# `=`, not `:=`: the header documents setting this empty to disable the
# override, and `:=` would treat an explicitly empty rc.conf value as
# unset and restore /usr/pkg/lib -- forcing pkgsrc libraries on an
# operator who asked for none. Only genuinely unset takes the default.
: ${netbbs_ld_library_path="/usr/pkg/lib"}
: ${netbbs_logfile:="${netbbs_statedir}/netbbs.service.log"}
# Graceful stop: SIGTERM makes NetBBS warn connected callers and wait up
# to shutdown.graceful_delay_seconds (60s default), after which teardown
# bounds itself with shutdown.background_task_drain_seconds. 150s leaves
# real headroom above both -- the same reasoning as the example systemd
# unit's TimeoutStopSec. Raise it if you raised graceful_delay_seconds.
: ${netbbs_stop_timeout:="150"}
# How long to wait for the node to report that its listeners are up
# before giving up on confirming the start. Generous: a first start on a
# large database runs an integrity check before it ever binds a socket.
: ${netbbs_start_timeout:="60"}

# The line netbbs logs once every listener is bound and it is actually
# serving (netbbs.__main__). Seeing this, rather than merely seeing the
# process alive, is what makes a reported start true.
netbbs_ready_marker="NetBBS is ready to accept connections"

# The pidfile lives in the node's own state directory rather than
# /var/run: this script backgrounds the node as netbbs_user (see
# netbbs_start below), and an unprivileged user cannot write /var/run.
#
# Deliberately NOT ${netbbs_statedir}/netbbs.pid. NetBBS writes its own
# pidfile beside the database as <db-stem>.pid (netbbs.backup's
# write_pid_file, called from netbbs.__main__ on every start and removed
# on every exit), which for the documented layout is exactly
# /var/lib/netbbs/netbbs.pid. That file is not ours to touch:
# netbbs.backup reads it to refuse a restore over a node that is still
# running, so this script clearing it before a start would remove a
# data-safety signal another subsystem depends on.
pidfile="${netbbs_statedir}/netbbs.service.pid"

# NetBBS deliberately never daemonizes itself (design doc §13.8): it runs
# in the foreground and expects a supervisor to background and restart
# it. NetBSD has no supervisor in base that does that for us -- daemon(8)
# is a FreeBSD program, and NetBSD ships only the libc daemon(3) function
# (issue #312: pointing $command at a nonexistent /usr/bin/daemon made
# rc.subr's `[ ! -x $command ] && return 0` report success and start
# nothing at all). So this script backgrounds the node itself and keeps
# its own pidfile, which is why start/stop/status are all custom below
# rather than rc.subr's pidfile/procname defaults.
start_cmd="netbbs_start"
stop_cmd="netbbs_stop"
status_cmd="netbbs_status"
# NetBSD's rc.subr rejects `status` as an unknown directive unless it is
# declared here.
extra_commands="status"

# Read the pidfile into $_pid, validated. This runs as root and the
# pidfile lives in a directory writable by netbbs_user, so its contents
# are untrusted input to `kill` -- not a number we can assume. `-1` is
# the case that matters: it passes `kill -0`, yields no `ps` output (so
# the deliberate "empty ps means still running" fail-safe below would
# call it live), and then `kill -TERM -1` signals every process on the
# host. Only a plain positive decimal is accepted. `read` also takes
# just the first line, so trailing junk cannot ride along.
# rc.conf values are operator input and reach `[ ... -ge ... ]`, where
# a non-integer makes the test error and evaluate false forever -- which
# would turn the bounded stop below into an unbounded wait, hanging
# `service netbbs stop` and, with KEYWORD: shutdown, the system
# shutdown with it. A negative value would instead skip straight to
# SIGKILL. Fall back to the documented default and say so, rather than
# either.
netbbs_seconds()
{
	# $1 = value, $2 = default, $3 = variable name (for the message)
	case "$1" in
	"" | *[!0-9]*)	;;
	*)	if [ "$1" -ge 1 ]; then
			echo "$1"
			return 0
		fi ;;
	esac
	echo "netbbs: ignoring invalid $3=\"$1\"; using $2 seconds." >&2
	echo "$2"
}

netbbs_read_pid()
{
	_pid=""
	[ -f "${pidfile}" ] || return 1
	# Not `read ... || return 1`: read reports failure at EOF on a final
	# line with no newline, having still assigned the value. Judge the
	# value itself -- an unreadable or empty file leaves $_pid empty and
	# is caught below, while a pidfile written without a trailing newline
	# must not read as "not running" and start a second node.
	read -r _pid < "${pidfile}" 2>/dev/null
	case "${_pid}" in
	"" | *[!0-9]*)	_pid=""; return 1 ;;
	esac
	# kill(2) reads 0 as "my whole process group"; a real pid is >= 1.
	if [ "${_pid}" -lt 1 ]; then
		_pid=""
		return 1
	fi
	return 0
}

netbbs_running()
{
	netbbs_read_pid || return 1
	kill -0 "${_pid}" 2>/dev/null || return 1
	# The pidfile lives in the state directory, so it survives a reboot
	# -- and a recycled pid belonging to some unrelated process would
	# otherwise read as "already running", leaving the node permanently
	# unstarted (the same silent-failure class this script exists to
	# fix) and making `stop` signal a stranger. Only trusted when ps
	# actually reports something: no output means ps could not tell us,
	# and "still running" is the safe answer there -- never start a
	# second node against the same database on a guess.
	_cmd=$(ps -p "${_pid}" -o command= 2>/dev/null)
	case "${_cmd}" in
	"")				return 0 ;;
	*"-m netbbs --config"*)		return 0 ;;
	*)				return 1 ;;
	esac
}

netbbs_start()
{
	if netbbs_running; then
		echo "netbbs already running as pid ${_pid}."
		return 1
	fi
	if [ ! -x "${netbbs_python}" ]; then
		echo "netbbs: ${netbbs_python} is not executable -- set netbbs_python in rc.conf." >&2
		return 1
	fi
	if [ ! -d "${netbbs_statedir}" ]; then
		echo "netbbs: state directory ${netbbs_statedir} does not exist." >&2
		return 1
	fi
	# The pidfile is written by netbbs_user, inside the su below. If that
	# write fails there is no pidfile to check afterwards, so the node
	# would start, keep running, and still be reported as failed -- and
	# the next start would launch a second one against the same database.
	# Check up front instead, where it can still be a clear message.
	if ! su -m "${netbbs_user}" -c "test -w \"${netbbs_statedir}\""; then
		echo "netbbs: ${netbbs_statedir} is not writable by ${netbbs_user}." >&2
		return 1
	fi
	rm -f "${pidfile}"
	# The logfile is appended to across restarts, so a readiness line from
	# an earlier run is already in it. Note where this start's output
	# begins and only look past that point.
	_log_from=$(wc -l < "${netbbs_logfile}" 2>/dev/null | tr -d ' ')
	case "${_log_from}" in
	"" | *[!0-9]*)	_log_from=0 ;;
	esac
	echo "Starting netbbs."
	# su -m leaves the environment alone, so HOME would still be root's.
	# Set it explicitly to the state directory: a door that keeps its own
	# per-caller save files does so under $HOME by default (see
	# netbbs.doors.bundled.voidrunner), and root's home is both wrong and
	# unwritable for netbbs_user.
	#
	# netbbs_ld_library_path (operator guide §1b): a `cryptography` built
	# against pkgsrc's openssl links against /usr/pkg/lib/libssl.so.3, but
	# NetBSD's runtime linker doesn't search /usr/pkg/lib by default and
	# the base system's own /usr/lib/libssl.so.16 can't satisfy that
	# SONAME -- confirmed on real hardware as an `import asyncssh` failure
	# ("Shared object libssl.so.3 not found") even though the package is
	# correctly installed. Only matters when the ssh extra is in use;
	# harmless otherwise. Set empty in rc.conf to disable.
	#
	# NetBBS logs to its own self-rotating netbbs.log beside the database
	# as well (operator guide §4); netbbs_logfile only captures what it
	# still writes to stdout/stderr, including a startup failure that
	# happens before logging is configured.
	#
	# This file does NOT rotate, and newsyslog(8) cannot make it: the
	# node holds this descriptor open for its whole life and has no
	# reopen-on-signal, so renaming the path just leaves it writing to
	# the renamed inode while the new file stays empty -- unbounded
	# growth on the same filesystem as the database, and rotation that
	# never fires again. Do not paper over that with a newsyslog entry.
	#
	# What it is actually for is the startup window: everything NetBBS
	# logs after logging is configured is already in its own
	# self-rotating netbbs.log beside the database (10 MiB, 5 backups,
	# operator guide §4). This file's unique content is what it writes
	# *before* that -- a config error, a failed import, a bad interpreter.
	#
	# So on a long-running node, set netbbs_logfile=/dev/null in rc.conf
	# once the install is known good and let netbbs.log be the log; keep
	# a real file while commissioning, or point it somewhere you rotate
	# by restarting the node. Readiness detection degrades gracefully
	# when it is not a regular file (see netbbs_start).
	# Publishing the pid is a precondition for letting the node keep
	# running, not a step after it. `test -w` above can pass and the
	# write still fail (exhausted inodes or quota), and by then the node
	# is already up -- so reporting a failed start would leave an
	# untracked live node that the next start would happily duplicate
	# against the same database. If the write fails, stop what we just
	# started and fail honestly.
	# Start from the state directory. A config may legitimately omit
	# [database].path, and NodeConfig then keeps relative defaults
	# (Path("netbbs.db"), Path("netbbs_identity")) which resolve
	# against the caller's working directory -- "/" for an rc.d start
	# at boot, where netbbs_user cannot create them, so the service
	# would fail with its own state directory perfectly writable.
	# HOME does not affect Path resolution; only cd does. The systemd
	# unit gets this from WorkingDirectory=.
	#
	# If the pid cannot be published, SIGKILL rather than SIGTERM: the
	# node is seconds old with no callers to warn, and SIGTERM would
	# start a graceful shutdown that may wait out
	# shutdown.graceful_delay_seconds -- leaving a live, untracked
	# node behind precisely while reporting it was stopped. WAL makes
	# an abrupt stop safe, and `wait` reaps it before we return.
	su -m "${netbbs_user}" -c "cd \"${netbbs_statedir}\" || exit 1; nohup env HOME=\"${netbbs_statedir}\" LD_LIBRARY_PATH=\"${netbbs_ld_library_path}\" \"${netbbs_python}\" -m netbbs --config \"${netbbs_config}\" >> \"${netbbs_logfile}\" 2>&1 & _child=\$!; if echo \$_child > \"${pidfile}\"; then :; else kill -KILL \$_child 2>/dev/null; wait \$_child 2>/dev/null; exit 1; fi"
	if [ $? -ne 0 ]; then
		echo "netbbs: could not write ${pidfile}; the node was stopped again." >&2
		rm -f "${pidfile}"
		return 1
	fi
	# Wait for the node to say it is serving, not for a fixed interval:
	# startup runs a database integrity check before binding anything, so
	# on a large database "the process is still alive after N seconds"
	# can be true well before any listener exists -- and if setup then
	# fails, the service has already reported success with no node
	# running. That is the exact failure this script exists to remove, so
	# it must not be reintroduced by a hopeful `sleep`.
	_start_timeout=$(netbbs_seconds "${netbbs_start_timeout}" 60 netbbs_start_timeout)
	# The readiness marker is read back out of the logfile, so it only
	# exists if that is a regular file. netbbs_logfile=/dev/null is a
	# documented and recommended setting (see above), and a char device
	# swallows the marker -- without this, every healthy start would sit
	# out the full timeout and then report an unconfirmed start, delaying
	# boot for no reason. Fall back to the weaker liveness check and say
	# which one was used, rather than silently doing either.
	if [ ! -f "${netbbs_logfile}" ]; then
		sleep 3
		if netbbs_running; then
			echo "netbbs started as pid ${_pid} (readiness unconfirmed:"
			echo "${netbbs_logfile} is not a regular file, so the node's"
			echo "ready marker cannot be read back)."
			return 0
		fi
		echo "netbbs failed to start -- ${netbbs_logfile} is not a regular" >&2
		echo "file, so there is no captured output to show." >&2
		rm -f "${pidfile}"
		return 1
	fi
	_waited=0
	while :; do
		if ! netbbs_running; then
			echo "netbbs failed to start -- see ${netbbs_logfile}." >&2
			tail -20 "${netbbs_logfile}" >&2
			rm -f "${pidfile}"
			return 1
		fi
		if tail -n "+$((_log_from + 1))" "${netbbs_logfile}" 2>/dev/null |
		   grep -q "${netbbs_ready_marker}"; then
			echo "netbbs started as pid ${_pid}."
			return 0
		fi
		if [ "${_waited}" -ge "${_start_timeout}" ]; then
			# Alive but unconfirmed. Not a failure we can assert -- a
			# very slow start looks the same from here -- so leave it
			# running and make the uncertainty the operator's to judge
			# rather than claiming either outcome.
			echo "netbbs is running as pid ${_pid} but has not reported readiness" >&2
			echo "within ${_start_timeout}s -- check ${netbbs_logfile}." >&2
			return 0
		fi
		sleep 1
		_waited=$((_waited + 1))
	done
}

netbbs_stop()
{
	if ! netbbs_running; then
		echo "netbbs is not running."
		rm -f "${pidfile}"
		return 0
	fi
	_timeout=$(netbbs_seconds "${netbbs_stop_timeout}" 150 netbbs_stop_timeout)
	echo "Stopping netbbs (pid ${_pid}), up to ${_timeout}s."
	kill -TERM "${_pid}"
	_waited=0
	while kill -0 "${_pid}" 2>/dev/null; do
		if [ "${_waited}" -ge "${_timeout}" ]; then
			# Last resort. A SIGKILLed node cannot run its own door
			# cleanup, and doors are deliberately spawned into their
			# own sessions (netbbs.doors.runtime: start_new_session),
			# so they are not in any process group this script could
			# signal instead -- only the node itself can reap them.
			# A door subprocess can therefore outlive a forced stop.
			# Keep netbbs_stop_timeout comfortably above
			# shutdown.graceful_delay_seconds so this stays unreached.
			echo "netbbs did not exit in ${_timeout}s; sending SIGKILL." >&2
			kill -KILL "${_pid}" 2>/dev/null
			# Even SIGKILL is not instant -- a process in uninterruptible
			# sleep stays alive until it leaves that state. Reporting
			# "stopped" and deleting the pidfile here would let the next
			# start launch a second node against the same database while
			# the first is still running, and untracked. Confirm, and
			# fail honestly if it is still there.
			_killed=0
			while [ "${_killed}" -lt 10 ]; do
				kill -0 "${_pid}" 2>/dev/null || break
				sleep 1
				_killed=$((_killed + 1))
			done
			if kill -0 "${_pid}" 2>/dev/null; then
				echo "netbbs (pid ${_pid}) survived SIGKILL -- leaving ${pidfile}" >&2
				echo "in place so it stays tracked. Do not start another node yet." >&2
				return 1
			fi
			break
		fi
		sleep 2
		_waited=$((_waited + 2))
	done
	rm -f "${pidfile}"
	echo "netbbs stopped."
}

netbbs_status()
{
	if netbbs_running; then
		echo "netbbs is running as pid ${_pid}."
	else
		echo "netbbs is not running."
		return 1
	fi
}

run_rc_command "$1"
