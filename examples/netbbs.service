# systemd unit for running a NetBBS node under Linux. Install as
# /etc/systemd/system/netbbs.service, adjust User/Group/WorkingDirectory/
# ExecStart for your install layout, then:
#
#   systemctl daemon-reload
#   systemctl enable --now netbbs
#
# This example assumes the layout of the SysOp handbook's "Installing
# NetBBS" section: a dedicated, unprivileged "netbbs" system user, and
# the GitHub-release wheel installed with its [ssh,web] extras into a
# virtual environment at /var/lib/netbbs/.venv. NetBBS is not published
# on PyPI, so follow the handbook's commands rather than a plain
# `pip install netbbs`. Adjust the paths if you installed differently.
# NetBBS never daemonizes itself: it runs in the foreground and expects
# the service supervisor to manage backgrounding and restarts, which is
# what Type=simple here does.

[Unit]
Description=NetBBS node
Documentation=https://github.com/Thiesi/NetBBS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netbbs
Group=netbbs
WorkingDirectory=/var/lib/netbbs
ExecStart=/var/lib/netbbs/.venv/bin/python -m netbbs --config /etc/netbbs/netbbs.toml

# NetBBS treats SIGTERM as "please shut down properly": it warns
# connected users, waits up to the configured
# shutdown.graceful_delay_seconds (60s by default), then disconnects
# and exits cleanly. TimeoutStopSec must stay comfortably above that
# default -- lower it only if you've also lowered graceful_delay_seconds
# in netbbs.toml.
KillSignal=SIGTERM
TimeoutStopSec=90

Restart=on-failure
RestartSec=5
# Installing a release from Settings -> Update ends with the
# node shutting down gracefully and exiting with status 75, so that it comes
# back up as the new version. Restart=on-failure alone already restarts on
# 75; these two lines also restart it under any other Restart= policy and keep
# it from being logged as a failure.
RestartForceExitStatus=75
SuccessExitStatus=75

# Hardening (optional, safe defaults for a network-facing service with
# no need to touch anything outside its own state directory). Loosen
# ReadWritePaths if your database/blob storage/identity directory lives
# somewhere other than WorkingDirectory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/netbbs

[Install]
WantedBy=multi-user.target
