{
  "name": "Native PTY setup template",
  "executable_path": "/usr/local/libexec/doors/game",
  "args": ["{node_dir}"],
  "profile": {
    "version": 1, "adapter": "native", "endpoint": "pty",
    "install_dir": "/var/games/netbbs/native", "drop_files": ["DORINFO1.DEF"],
    "encoding": "utf-8", "width": 80, "height": 25, "max_sessions": 1,
    "environment": {"TERM": "ansi"}
  }
}
